# Copy to .env and fill in on the machine that runs `st`. Never commit .env.
# ST_ROOT is the directory that holds bots/*.json, .token, and .lock.
# Leave empty to use ~/.grokbot-task-dashboard.
ST_ROOT=
ST_PUSH_URL=https://YOUR_DOMAIN/api/push
ST_TZ=America/New_York
ST_STATS_DAYS=90
ST_HISTORY_DAYS=7
ST_STATS_MAX=500
ST_CALIBRATE_MIN=3
ST_LANG=zh
# Optional roster override. Name and description, comma-separated.
# ST_BOTS=Coordinator:Routes work,Researcher:Reads sources,Coder:Implements changes,Ops:Deploy and monitoring
ST_PUSH_RETRIES=2
